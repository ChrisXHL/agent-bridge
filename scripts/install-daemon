#!/usr/bin/python3
"""Install the isolated 2.0 receiver as a per-user macOS LaunchAgent."""
import os
import pathlib
import plistlib
import shutil
import subprocess
import sys
import time
import urllib.request

root=pathlib.Path(__file__).resolve().parent.parent
home=pathlib.Path.home()
agent_dir=home/'Library/LaunchAgents'
data_dir=home/'Library/Application Support/CodexBridgeV2'
log_dir=home/'Library/Logs/CodexBridgeV2'
for path in (agent_dir,data_dir,log_dir):
    path.mkdir(parents=True,exist_ok=True)
    if path==data_dir: path.chmod(0o700)
os.umask(0o077)
label='dev.codex.bridge.v2'
plist=agent_dir/(label+'.plist')
sys.path.insert(0,str(root))
from codex_runtime import resolve_codex_binary
codex_bin=resolve_codex_binary(os.getenv('CODEX_BIN'))
runtime=root/'.venv/bin/python'
if not runtime.is_file():
    raise SystemExit('Create the 2.0 .venv and install requirements first')
args=[str(runtime),str(root/'service.py'),'--db',str(data_dir/'bridge.sqlite3'),'--projects',str(root/'projects.json'),'--port','8797']
config={'Label':label,'ProgramArguments':args,'WorkingDirectory':str(root),'RunAtLoad':True,'KeepAlive':True,'StandardOutPath':str(log_dir/'service.log'),'StandardErrorPath':str(log_dir/'error.log'),'EnvironmentVariables':{'HOME':str(home),'USER':os.getenv('USER',home.name),'LOGNAME':os.getenv('LOGNAME',home.name),'PATH':os.getenv('PATH','/usr/local/bin:/usr/bin:/bin'),'BRIDGE_REQUIRE_APP':'1','CODEX_BIN':codex_bin,'PYTHONUNBUFFERED':'1','FEISHU_CONFIG':str(data_dir/'feishu.json')}}
with plist.open('wb') as f: plistlib.dump(config,f)
uid=os.getuid()
subprocess.run(['launchctl','bootout',f'gui/{uid}/{label}'],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
subprocess.run(['launchctl','bootstrap',f'gui/{uid}',str(plist)],check=True)
subprocess.run(['launchctl','kickstart','-k',f'gui/{uid}/{label}'],check=True)
for _ in range(30):
    try:
        with urllib.request.urlopen('http://127.0.0.1:8797/healthz',timeout=1) as r:
            if r.status==200:
                print('Codex Bridge 2.0 running at http://127.0.0.1:8797/panel')
                break
    except Exception: time.sleep(0.5)
else: raise SystemExit('LaunchAgent installed but health check failed; inspect '+str(log_dir/'error.log'))
