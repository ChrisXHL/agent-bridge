#!/usr/bin/env python3
"""Durable workflow CLI fallback for already-running Codex sessions."""
import argparse
import json
import sys
from pathlib import Path
from urllib.parse import quote
sys.path.insert(0,str(Path(__file__).resolve().parent.parent))
from mcp_server import fetch,post
p=argparse.ArgumentParser(description='Inspect or advance a Codex Bridge workflow')
g=p.add_mutually_exclusive_group(required=True)
g.add_argument('--get',metavar='RUN_ID')
g.add_argument('--list',action='store_true')
g.add_argument('--file',help='JSON arguments file or - for stdin')
a=p.parse_args()
try:
    if a.list:result=fetch('/api/feishu/workflow-runs')
    elif a.get:result=fetch('/api/feishu/workflow-runs/'+quote(a.get,safe=''))
    else:
        args=json.load(sys.stdin) if a.file=='-' else json.loads(Path(a.file).read_text())
        result=post('/api/feishu/workflow-run',args)
    print(json.dumps(result,ensure_ascii=False,indent=2))
except Exception as exc:
    print(str(exc),file=sys.stderr);sys.exit(1)
