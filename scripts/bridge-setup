#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
for candidate in .venv/bin/python python3.13 python3.12 python3.11 python3; do
  if command -v "$candidate" >/dev/null 2>&1 && "$candidate" -c 'import sys;sys.exit(not ((3,11)<=sys.version_info[:2]<(3,14)))' 2>/dev/null; then
    exec "$candidate" bridge_setup.py "$@"
  fi
done
echo '{"stage":"needs_agent","missing":["python"],"next_action":"agent_install_python_3_13_from_official_source","user_action_required":false}'
